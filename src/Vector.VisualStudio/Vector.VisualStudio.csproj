<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <AssemblyName>Vector.VisualStudio</AssemblyName>
    <RootNamespace>Vector.VisualStudio</RootNamespace>
    <AssemblyVSIXSubPath>OutOfProc</AssemblyVSIXSubPath>
    <CreateVsixContainer>false</CreateVsixContainer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vector.ExecutionProtocol\Vector.ExecutionProtocol.csproj" />
    <ProjectReference Include="..\Vector.ExecutionHost\Vector.ExecutionHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Vector.LanguageServer\Vector.LanguageServer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyVectorLanguageServer" AfterTargets="Build">
    <ItemGroup>
      <VectorLanguageServerFiles Include="..\Vector.LanguageServer\bin\$(Configuration)\net8.0\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(VectorLanguageServerFiles)"
      DestinationFiles="@(VectorLanguageServerFiles->'$(OutputPath)LanguageServer\%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyVectorExecutionHost" AfterTargets="Build">
    <ItemGroup>
      <VectorExecutionHostFiles Include="..\Vector.ExecutionHost\bin\$(Configuration)\net8.0\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(VectorExecutionHostFiles)"
      DestinationFiles="@(VectorExecutionHostFiles->'$(OutputPath)ExecutionHost\%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="IncludeVectorLanguageServerInVsix" BeforeTargets="GetVsixSourceItems">
    <ItemGroup>
      <VSIXSourceItem Include="..\Vector.LanguageServer\bin\$(Configuration)\net8.0\*">
        <VSIXSubPath>OutOfProc\LanguageServer</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <Target Name="IncludeVectorExecutionHostInVsix" BeforeTargets="GetVsixSourceItems">
    <ItemGroup>
      <VSIXSourceItem Include="..\Vector.ExecutionHost\bin\$(Configuration)\net8.0\*">
        <VSIXSubPath>OutOfProc\ExecutionHost</VSIXSubPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <!-- Project output groups are consumed from the sibling VSSDK container. Make generated
       metadata paths absolute so the container does not resolve them under its own bin folder. -->
  <Target Name="NormalizeGeneratedExtensionMetadataPaths" AfterTargets="GetVsixSourceItems" BeforeTargets="ExtensionFilesOutputGroup">
    <ItemGroup>
      <VSIXSourceItem Update="@(VSIXSourceItem)">
        <FinalOutputPath>%(FullPath)</FinalOutputPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

</Project>
