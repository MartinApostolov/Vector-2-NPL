{
  "name": "vector-language-support",
  "displayName": "Vector Language Support",
  "description": "Language support and isolated execution for the Vector programming language.",
  "version": "0.1.0",
  "publisher": "martinapostolov",
  "repository": {
    "type": "git",
    "url": "https://github.com/MartinApostolov/Vector-2-NPL.git"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:vector",
    "onCommand:vector.runCurrentFile",
    "onCommand:vector.runCurrentFileWithInterpreter",
    "onCommand:vector.runCurrentFileWithVm",
    "onCommand:vector.showBytecode"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vector.runCurrentFile",
        "title": "Vector: Run Current File"
      },
      {
        "command": "vector.runCurrentFileWithInterpreter",
        "title": "Vector: Run Current File with Interpreter"
      },
      {
        "command": "vector.runCurrentFileWithVm",
        "title": "Vector: Run Current File with VM"
      },
      {
        "command": "vector.showBytecode",
        "title": "Vector: Show Bytecode"
      }
    ],
    "configuration": {
      "title": "Vector",
      "properties": {
        "vector.defaultExecutionEngine": {
          "type": "string",
          "enum": [
            "Interpreter",
            "VM"
          ],
          "default": "Interpreter",
          "description": "Execution engine used by Vector: Run Current File."
        },
        "vector.liveDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Publish Vector lexer and parser diagnostics while editing."
        },
        "vector.programRoot": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional Vector program root. Relative paths are resolved from the containing workspace folder."
        },
        "vector.executionPluginPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Explicit Vector plugin assembly paths used for execution. Relative paths are resolved from the containing workspace folder."
        }
      }
    },
    "languages": [
      {
        "id": "vector",
        "aliases": [
          "Vector",
          "vector"
        ],
        "extensions": [
          ".vec"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vector",
        "scopeName": "source.vector",
        "path": "./syntaxes/vector.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node ./scripts/build.mjs",
    "package:bundle": "npm run check-types && node ./scripts/build.mjs --production",
    "vscode:prepublish": "npm run package:bundle",
    "test:unit": "npm run compile && node --test dist-test/test/unit/*.test.js",
    "test:process": "npm run build:hosts && npm run compile && node --test dist-test/test/process/*.test.js",
    "test:extension": "npm run build:payload && npm run compile && vscode-test",
    "build:hosts": "dotnet build ../Vector.LanguageServer/Vector.LanguageServer.csproj --configuration Release --no-restore && dotnet build ../Vector.ExecutionHost/Vector.ExecutionHost.csproj --configuration Release --no-restore",
    "build:payload": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/Build-VSCodePayload.ps1",
    "test": "npm run test:unit && npm run test:process"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/mocha": "10.0.10",
    "@types/vscode": "1.104.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
