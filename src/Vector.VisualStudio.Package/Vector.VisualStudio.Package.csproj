<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <VssdkCompatibleExtension>true</VssdkCompatibleExtension>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vector.VisualStudio\Vector.VisualStudio.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <IncludeInVSIX>true</IncludeInVSIX>
      <IncludeOutputGroupsInVSIX>ExtensionFilesOutputGroup</IncludeOutputGroupsInVSIX>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <VSIXSourceItem Include="..\Vector.VisualStudio\bin\$(Configuration)\net8.0-windows8.0\.vsextension\extension.json" VsixSubPath=".vsextension" />
    <VSIXSourceItem Include="..\Vector.VisualStudio\Grammars\vector.tmLanguage.json" VsixSubPath="Grammars" />
    <VSIXSourceItem Include="..\Vector.VisualStudio\LanguageConfiguration\vector-language-configuration.json" VsixSubPath="LanguageConfiguration" />
    <VSIXSourceItem Include="..\Vector.VisualStudio\Vector.LanguageConfiguration.pkgdef" />
  </ItemGroup>

</Project>
